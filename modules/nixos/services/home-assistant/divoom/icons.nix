# 16x16 status icons for the Divoom Timebox-Evo, one PNG per status, drawn in
# the status colour on black ('#' full colour, '+' a third of it, '.' off).
#
# The integration only reads images from its media directory
# (/var/lib/hass/pixelart, `pixelart` in the config entry) and refuses any
# path whose realpath leaves it, so the whole directory is linked to the
# build output rather than each file.
{ pkgs, statuses }:

let
  shapes = {
    dishwasher = [
      "................"
      ".##############."
      ".#.#.#....++++#."
      ".##############."
      ".#............#."
      ".#.#..#..#..#.#."
      ".#.#..#..#..#.#."
      ".#.#..#..#..#.#."
      ".#.##########.#."
      ".#............#."
      ".#..+..+..+...#."
      ".#..+..+..+...#."
      ".#.##########.#."
      ".#............#."
      ".##############."
      "................"
    ];
    washing_machine = [
      "................"
      ".##############."
      ".#.##.#...++++#."
      ".##############."
      ".#....####....#."
      ".#..##....##..#."
      ".#.#........#.#."
      ".#.#........#.#."
      ".##.+.+.+.+.+##."
      ".##++++++++++##."
      ".#.#++++++++#.#."
      ".#..##++++##..#."
      ".#....####....#."
      ".#............#."
      ".##############."
      "................"
    ];
    dryer = [
      "................"
      ".##############."
      ".#.##.#...++++#."
      ".##############."
      ".#....####....#."
      ".#..##....##..#."
      ".#.#..+..+..#.#."
      ".#.#.+..+..+#.#."
      ".##..+..+..+.##."
      ".##...+..+...##."
      ".#.#..+..+..#.#."
      ".#..##....##..#."
      ".#....####....#."
      ".#............#."
      ".##############."
      "................"
    ];
    mail = [
      "................"
      "................"
      "................"
      ".##############."
      ".##..........##."
      ".#.#........#.#."
      ".#..#......#..#."
      ".#...#....#...#."
      ".#....#..#....#."
      ".#.....##.....#."
      ".#............#."
      ".#............#."
      ".#............#."
      ".##############."
      "................"
      "................"
    ];
    trash = [
      "......####......"
      "..############.."
      "................"
      "...##########..."
      "...#+.+..+.+#..."
      "...#+.+..+.+#..."
      "...#+.+..+.+#..."
      "...#+.+..+.+#..."
      "...#+.+..+.+#..."
      "...#+.+..+.+#..."
      "...#+.+..+.+#..."
      "...#+.+..+.+#..."
      "...#+.+..+.+#..."
      "....########...."
      "................"
      "................"
    ];
    recycling = [
      "......####......"
      "..############.."
      "................"
      "...##########..."
      "...#........#..."
      "...#...##...#..."
      "...#..#..#..#..."
      "...#.#....#.#..."
      "...#.######.#..."
      "...#........#..."
      "...#........#..."
      "...#........#..."
      "...#........#..."
      "....########...."
      "................"
      "................"
    ];
  };

  spec = map (s: {
    inherit (s) key rgb;
    rows = shapes.${s.icon};
  }) statuses;

  python = pkgs.python3.withPackages (ps: [ ps.pillow ]);
in
pkgs.runCommand "divoom-status-icons"
  {
    nativeBuildInputs = [ python ];
    spec = builtins.toJSON spec;
    passAsFile = [ "spec" ];
  }
  ''
    mkdir $out
    python3 - "$specPath" "$out" <<'EOF'
    import json, sys
    from PIL import Image

    spec, out = sys.argv[1:]
    for icon in json.load(open(spec)):
        rgb = tuple(icon["rgb"])
        dim = tuple(c // 3 for c in rgb)
        rows = icon["rows"]
        assert len(rows) == 16 and all(len(r) == 16 for r in rows), icon["key"]
        img = Image.new("RGB", (16, 16))
        for y, row in enumerate(rows):
            for x, c in enumerate(row):
                img.putpixel((x, y), {"#": rgb, "+": dim, ".": (0, 0, 0)}[c])
        img.save(f"{out}/{icon['key']}.png")
    EOF
  ''
