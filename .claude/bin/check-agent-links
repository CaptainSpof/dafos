#!/usr/bin/env python3
"""Check that the agent guidance still points at things that exist.

Scans every AGENTS.md, CLAUDE.md and README.md in the repo plus .claude/skills/**/*.md:
- relative Markdown links resolve (from the file's directory);
- backticked repo paths (`modules/...`, `flake-modules/...`, ...) resolve from the root;
- each CLAUDE.md is exactly `@AGENTS.md` with an AGENTS.md beside it.
Placeholders (<host>, *, {a,b}, $VAR) are skipped; http links are not fetched.
Usage: .claude/bin/check-agent-links   (run from the repo root; exit 1 on any problem)
"""
import os, re, subprocess, sys

ROOTS = ("modules", "flake-modules", "systems", "homes", "packages", "secrets", "lib",
         "esphome", "glove80", "templates", "tests", "overlays", "shells", "checks", ".claude")
LINK = re.compile(r"\]\(([^)\s#]+)")
TICK = re.compile(r"`((?:%s)/[^`\s]+)`" % "|".join(re.escape(r) for r in ROOTS))
SKIP = re.compile(r"[<>*{}$]")
WHOLE_LINK = re.compile(r"\[[^\]]*\]\([^)]*\)")  # link text is checked through its target

files = subprocess.run(["git", "ls-files", "-co", "--exclude-standard"],
                       capture_output=True, text=True, check=True).stdout.split()
docs = [f for f in files if os.path.basename(f) in ("AGENTS.md", "CLAUDE.md", "README.md")
        or (f.startswith(".claude/skills/") and f.endswith(".md"))]

bad = []
for f in docs:
    text = open(f, encoding="utf-8").read()
    if os.path.basename(f) == "CLAUDE.md":
        if text.strip() != "@AGENTS.md" or not os.path.exists(os.path.join(os.path.dirname(f), "AGENTS.md")):
            bad.append(f"{f}: not a one-line @AGENTS.md import next to an AGENTS.md")
        continue
    for n, line in enumerate(text.splitlines(), 1):
        for target in LINK.findall(line):
            if "://" in target or target.startswith("mailto:") or SKIP.search(target):
                continue
            if not os.path.exists(os.path.normpath(os.path.join(os.path.dirname(f), target))):
                bad.append(f"{f}:{n}: broken link {target}")
        for path in TICK.findall(WHOLE_LINK.sub("", line)):
            if not SKIP.search(path) and not os.path.exists(path.rstrip("/").split(":")[0]):
                bad.append(f"{f}:{n}: missing path {path}")

print("\n".join(bad) or f"ok: {len(docs)} files")
sys.exit(1 if bad else 0)
