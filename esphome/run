#!/usr/bin/env bash
# Runs an ESPHome command on one of the device configs in this directory,
# from a work directory outside the repo so the decrypted secrets.yaml and the
# .esphome build tree never land in git.
#
#   esphome/run config minuteur
#   esphome/run compile minuteur
#   esphome/run upload minuteur --device minuteur.local
#   esphome/run logs minuteur
set -euo pipefail

if [ $# -lt 2 ]; then
  echo "usage: $0 <esphome command> <device> [esphome args...]" >&2
  exit 1
fi
cmd=$1 device=$2
shift 2

here=$(cd "$(dirname "$0")" && pwd)
repo=$(dirname "$here")
work=${XDG_CACHE_HOME:-$HOME/.cache}/dafos-esphome

mkdir -p "$work"
cp "$here/$device.yaml" "$work/"
# C++ headers a config includes (esphome: includes: <device>/...).
if [ -d "$here/$device" ]; then
  rm -rf "${work:?}/$device"
  cp -r "$here/$device" "$work/"
fi
# Decrypted only for the duration of the command.
trap 'rm -f "$work/secrets.yaml"' EXIT
(umask 077 && sops -d "$repo/secrets/dafoltop/esphome.yaml" >"$work/secrets.yaml")

# esphome from the flake's own nixpkgs pin.
esphome=$(nix build --no-link --print-out-paths --inputs-from "$repo" nixpkgs#esphome)/bin/esphome
# nixpkgs' esphome 2026.9.1 wrapper exports PROTOCOL_BUFFERS_PYTHON_IMPLEMENTATION
# with its quotes kept ('python'), which protobuf 7 rejects at import. Run a
# copy with that line fixed; drop this once the wrapper is fixed upstream.
if grep -q "^export PROTOCOL_BUFFERS_PYTHON_IMPLEMENTATION=''" "$esphome"; then
  sed '/^export PROTOCOL_BUFFERS_PYTHON_IMPLEMENTATION=/c export PROTOCOL_BUFFERS_PYTHON_IMPLEMENTATION=python' \
    "$esphome" >"$work/esphome"
  chmod +x "$work/esphome"
  esphome=$work/esphome
fi
"$esphome" "$cmd" "$work/$device.yaml" "$@"
