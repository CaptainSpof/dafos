{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:recommended", "docker:enableMajor"],
	"timezone": "Europe/Paris",
	"enabledManagers": ["custom.regex", "nix"],
	"platformAutomerge": false,
	"packageRules": [
		{
			"description": "Merge minor/patch/digest bumps of >=1.0 images once the VM boot test is green (images only: flake input refs such as the HA integrations stay manual)",
			"matchUpdateTypes": ["minor", "patch", "digest"],
			"matchCurrentVersion": "!/^v?0\\./",
			"automerge": true,
			"automergeType": "pr",
			"matchDatasources": ["docker"]
		},
		{
			"matchManagers": ["custom.regex"],
			"additionalBranchPrefix": "{{parentDir}}-"
		},
		{
			"description": "Multi-container stacks: bump their images together",
			"matchDatasources": ["docker"],
			"matchPackageNames": ["/barassistant/"],
			"groupName": "{{parentDir}}"
		},
		{
			"description": "Databases and search indexes need a planned migration, not a drive-by bump",
			"matchDatasources": ["docker"],
			"matchPackageNames": [
				"/postgres/",
				"/pgvector/",
				"/redis/",
				"/valkey/",
				"/meilisearch/"
			],
			"enabled": false
		},
		{
			"description": "Flake inputs that track a branch move with the weekly lock file maintenance PR, not one PR each",
			"matchManagers": ["nix"],
			"matchUpdateTypes": ["digest"],
			"enabled": false
		}
	],
	"customManagers": [
		{
			"customType": "regex",
			"description": "Container image pins: image = \"repo:tag\";",
			"managerFilePatterns": ["/.*\\.nix$/"],
			"matchStrings": [
				"(?:# renovate: (?:versioning=(?<versioning>[^\\s]+)\\s+)?(?:extractVersion=(?<extractVersion>[^\\s]+)\\s*)?)?image\\s*=\\s*\"(?<depName>[^:\"]+):(?<currentValue>[^\"\\s]+)\"\\s*;"
			],
			"datasourceTemplate": "docker",
			"versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}docker{{/if}}",
			"extractVersionTemplate": "{{#if extractVersion}}{{{extractVersion}}}{{/if}}"
		}
	],
	"lockFileMaintenance": {
		"enabled": true,
		"description": "Weekly nix flake update; the integration workflow boots every local stack on flake.lock changes. Left for review: stack tests do not cover the hosts.",
		"schedule": ["before 6am on monday"],
		"commitMessageAction": "bump",
		"automerge": false
	},
	"nix": {
		"enabled": true
	}
}
